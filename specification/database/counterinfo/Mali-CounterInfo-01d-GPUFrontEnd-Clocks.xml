<CounterInfoList>
  <!-- ==================================================================== -->
  <CounterInfo>
    <MachineName>MaliClockRatioSC</MachineName>
    <StableID>65596</StableID>
    <HumanName>Shader core clock ratio</HumanName>
    <GroupName>GPU Clock Ratios</GroupName>
    <GroupHumanName>Shader core clock ratio</GroupHumanName>
    <Units>percent</Units>
    <Trend>Informative</Trend>
    <Visibility>Novice</Visibility>
    <ShortDescription>
      An estimate of shader core clock relative to the GPU top-level clock.
    </ShortDescription>
    <LongDescription>
      This expression estimates the shader core clock as a percentage relative
      to the top-level GPU clock.

      In smaller systems with fewer shader cores, it is common that the shader
      cores will be clocked at the same frequency as the GPU top-level.

      In larger systems with more shader cores, it is common to reduce the
      shader core clock frequency and run the cores at a lower voltage to
      improve energy efficiency.
    </LongDescription>
    <Equation>
      (MaliAnyActiveCy / MaliConfigCoreCount / MaliGPUActiveCy) * 100
    </Equation>
    <SupportedGPUs>
      <GPU>Mali-G78</GPU>
      <GPU>Mali-G710</GPU>
      <GPU>Mali-G715</GPU>
      <GPU>Mali-G720</GPU>
      <GPU>Mali-G725</GPU>
      <GPU>Mali G1</GPU>
      <GPU>Mali G2</GPU>
    </SupportedGPUs>
    <Perfetto>
      <Groups>
        <GroupName>System</GroupName>
      </Groups>
    </Perfetto>
  </CounterInfo>
  <!-- ==================================================================== -->
  <CounterInfo>
    <MachineName>MaliClockRatioNX</MachineName>
    <StableID>799</StableID>
    <HumanName>Neural accelerator clock ratio</HumanName>
    <GroupName>GPU Clock Ratios</GroupName>
    <GroupHumanName>Neural accelerator clock ratio</GroupHumanName>
    <Units>percent</Units>
    <Trend>Informative</Trend>
    <Visibility>Novice</Visibility>
    <ShortDescription>
      An estimate of neural accelerator clock relative to the GPU top-level
      clock.
    </ShortDescription>
    <LongDescription>
      This expression estimates the neural accelerator clock as a percentage
      relative to the top-level GPU clock.

      The neural accelerator is commonly clocked at a higher frequency than the
      shader core clock.
    </LongDescription>
    <Equation>
      (MaliNXActiveCy / MaliConfigNeuralAcceleratorCount / MaliGPUActiveCy) * 100
    </Equation>
    <SupportedGPUs>
      <GPU>Mali G1</GPU>
      <GPU>Mali G2</GPU>
    </SupportedGPUs>
    <Perfetto>
      <Groups>
        <GroupName>System</GroupName>
      </Groups>
    </Perfetto>
  </CounterInfo>
</CounterInfoList>
